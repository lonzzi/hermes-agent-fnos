#!/bin/bash
set -eu

# Verify that fnOS kept the persistent mounts after replacing the package.
[ -s "$TRIM_PKGETC/dashboard.env" ] || {
    echo 'dashboard.env is missing after upgrade.' > "$TRIM_TEMP_LOGFILE"
    exit 1
}
[ -d "$TRIM_PKGVAR/hermes" ] || {
    echo 'Hermes data directory is missing after upgrade.' > "$TRIM_TEMP_LOGFILE"
    exit 1
}
grep -q '^HERMES_DASHBOARD_BASIC_AUTH_SECRET=' "$TRIM_PKGETC/dashboard.env" || {
    echo 'Stable dashboard session secret is missing after upgrade.' > "$TRIM_TEMP_LOGFILE"
    exit 1
}
grep -q '^HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=' "$TRIM_PKGETC/dashboard.env" || {
    echo 'Dashboard session lifetime is missing after upgrade.' > "$TRIM_TEMP_LOGFILE"
    exit 1
}
